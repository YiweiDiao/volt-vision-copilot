# Optional SAIA configuration for the Volt Vision Copilot.
# Leave VOLT_VISION_SAIA_API_KEY empty in this tracked template.
# Without these values, the app must use deterministic fallback chat.

VOLT_VISION_SAIA_API_KEY=
VOLT_VISION_SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
VOLT_VISION_SAIA_MODEL=glm-4.7
VOLT_VISION_SAIA_MAX_TOKENS=1024
